         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.captainssingapura-hue.homing.graphview</groupId>
        <artifactId>homing-graph-view</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>homing-graph-view-layout</artifactId>
    <description>
        What is read from a graph before it is drawn: the closure of a vertex, the layers by depth, a layer laid out
        flat in a block, and a selection's meaning, asked of a Focus, with reachability as the default. No JavaFX and
        no geometry: a placement is depths, lanes and rows.
    </description>

