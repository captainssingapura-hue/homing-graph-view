<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.captainssingapura-hue.homing.graphview</groupId>
    <artifactId>homing-graph-view</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>
        An embeddable 3D explorer for dependency graphs, in JavaFX. Its features and its work are kept in
        homing-graph-view-studio, which also checks this code; nothing here depends on the studio.
    </description>

    <licenses>
        <license>
            <name>MIT</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <modules>
        <!-- The graph: vertices and edges only, as jOntology values. Java and jOntology core, nothing else. -->
        <module>homing-graph-view-model</module>
        <!-- What is read from a graph before it is drawn: closure, layers by depth, and Focus with Reachability. No JavaFX. -->
        <module>homing-graph-view-layout</module>
        <!-- GraphView, the embeddable JavaFX node that draws a graph in 3D. -->
        <module>homing-graph-view-fx</module>
        <!-- A window over GraphView showing the JDK's own modules; not published. mvn -pl homing-graph-view-demo javafx:run -->
        <module>homing-graph-view-demo</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jontology.version>0.1.0</jontology.version>
        <junit.version>5.11.3</junit.version>
        <javafx.version>25.0.1</javafx.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.captainssingapura-hue.lang.ontology</groupId>
                <artifactId>core</artifactId>
                <version>${jontology.version}</version>
            </dependency>
            <!-- jOntology's enforcer, for the tests: each type keeps the contract it declares. -->
            <dependency>
                <groupId>io.github.captainssingapura-hue.lang.ontology</groupId>
                <artifactId>enforcer</artifactId>
                <version>${jontology.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.captainssingapura-hue.lang.ontology</groupId>
                <artifactId>enforcing-utils</artifactId>
                <version>${jontology.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Every module ships its sources: the studio's quality checks read them beside the jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
